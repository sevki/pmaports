maintainer="Antoine Martin (ayakael) <dev@ayakael.net>"
pkgname=u-boot-clockworkpi-uconsole-radxa-cm5
pkgver=2026.07
pkgrel=0
_ddr_ver=1.24
_trust_ver=1.56
pkgdesc="u-boot bootloader for the ClockworkPi with Radxa CM5 (rk3588)"
url="https://gitlab.com/u-boot/u-boot/"
arch="aarch64"
license="GPL-2.0-or-later OFL-1.1 BSD-2-Clause BSD-3-Clause eCos-2.0 IBM-pibs
	ISC LGPL-2.0-only LGPL-2.1-only X11"
options="!check"

makedepends="
	bash
	bc
	bison
	dtc
	flex
	gnutls-dev
	libfdt
	make
	openssl-dev
	py3-elftools
	py3-setuptools
	python3-dev
	swig
"
_rkbin_commit="bffaab066e126037bf237bd7066e50db60af7f03"
builddir="$srcdir"/u-boot-$pkgver

source="
	https://ftp.denx.de/pub/u-boot/u-boot-${pkgver//_/-}.tar.bz2
	https://github.com/rockchip-linux/rkbin/raw/$_rkbin_commit/bin/rk35/rk3588_ddr_lp4_2112MHz_lp5_2400MHz_v$_ddr_ver.bin
	https://github.com/rockchip-linux/rkbin/raw/$_rkbin_commit/bin/rk35/rk3588_bl31_v$_trust_ver.elf
	https://ayakael.net/api/packages/forge/generic/spl_loader_rk3588/1.19.113/rk3588_spl_loader_v1.19.113.bin
	0001-Add-uconsole-rk3588-board-information.patch
	0001-pylibfdt-Replace-removed-SWIG-Python-2-compatibility.patch
	update-u-boot
"

build() {
	export ROCKCHIP_TPL="$srcdir"/rk3588_ddr_lp4_2112MHz_lp5_2400MHz_$_ddr_ver.bin
	export BL31="$srcdir"/rk3588_bl31_v$_trust_ver.elf

	make uconsole-rk3588_defconfig
	make

	# make idbloader.img
	tools/mkimage -n rk3588 -T rksd -d "$ROCKCHIP_TPL:$builddir"/spl/u-boot-spl.bin "$builddir"/idbloader.img
}

package() {
	install -D -m755 "$srcdir"/update-u-boot "$pkgdir"/usr/sbin/update-u-boot
	install -Dm644 \
		"$builddir"/idbloader.img \
		"$builddir"/u-boot.itb \
		"$srcdir"/rk3588_spl_loader_v1.19.113.bin \
		-t "$pkgdir"/usr/share/u-boot/clockworkpi-uconsole-radxa-cm5
}

