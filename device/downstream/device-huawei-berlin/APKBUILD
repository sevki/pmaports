# Reference: <https://postmarketos.org/devicepkg>
maintainer="Why-com-ui <cr19451010@gmail.com>"
pkgname=device-huawei-berlin
pkgdesc="Huawei Honor 6X"
pkgver=6
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	firmware-huawei-berlin
	hisi-wlan
	linux-huawei-berlin
	mkbootimg
	msm-fb-refresher
	postmarketos-base
"
makedepends="devicepkg-dev"
install="$pkgname-xfce-openrc.post-install"
subpackages="
	$pkgname-xfce:xfce
	$pkgname-xfce-openrc:xfce_openrc
"
source="
	90-honor6x-lightdm.conf
	honor6x-display-manager.initd
	honor6x-lightdm-greeter-wrapper
	honor6x-lightdm-session-wrapper
	honor6x-display-setup
	honor6x-displayctl
	honor6x-fbdev.conf.in
	honor6x-screen-toggle.initd
	honor6x-screen-toggle.py
	honor6x-xorg-policy.conf
	device-huawei-berlin-xfce-openrc.post-install
	deviceinfo
	kernel-cmdline.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
}

xfce() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-xfce4"
	depends="
		honor6x-fbdevhw-compat
		python3
		xf86-input-libinput
		xf86-video-fbdev
	"

	install -Dm644 "$srcdir"/honor6x-fbdev.conf.in \
		"$subpkgdir"/usr/share/honor6x/honor6x-fbdev.conf.in
	install -Dm755 "$srcdir"/honor6x-display-setup \
		"$subpkgdir"/usr/bin/honor6x-display-setup
	install -Dm755 "$srcdir"/honor6x-displayctl \
		"$subpkgdir"/usr/bin/honor6x-displayctl
	install -Dm755 "$srcdir"/honor6x-screen-toggle.py \
		"$subpkgdir"/usr/bin/honor6x-screen-toggle
	install -Dm755 "$srcdir"/honor6x-lightdm-greeter-wrapper \
		"$subpkgdir"/usr/bin/honor6x-lightdm-greeter-wrapper
	install -Dm755 "$srcdir"/honor6x-lightdm-session-wrapper \
		"$subpkgdir"/usr/bin/honor6x-lightdm-session-wrapper
	install -Dm644 "$srcdir"/honor6x-xorg-policy.conf \
		"$subpkgdir"/usr/share/X11/xorg.conf.d/22-honor6x-xorg-policy.conf
	install -Dm644 "$srcdir"/90-honor6x-lightdm.conf \
		"$subpkgdir"/usr/share/lightdm/lightdm.conf.d/90-honor6x.conf
}

xfce_openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-xfce4 openrc"
	depends="$pkgname-xfce=$pkgver-r$pkgrel openrc"

	install -Dm755 "$srcdir"/honor6x-display-manager.initd \
		"$subpkgdir"/etc/init.d/honor6x-display-manager
	install -Dm755 "$srcdir"/honor6x-screen-toggle.initd \
		"$subpkgdir"/etc/init.d/honor6x-screen-toggle
}

