# Reference: <https://postmarketos.org/devicepkg>
maintainer="Anri Dellal <anridellal@gmail.com>"
pkgname=device-nobby-230
pkgdesc="Nobby 230"
pkgver=6
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="soc-sprd-audio-sc8830 msm-fb-refresher postmarketos-base linux-nobby-230 mkbootimg"
makedepends="devicepkg-dev"
install="$pkgname.post-install"
source="
	deviceinfo
	kernel-cmdline.conf
	telnetd
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir"/telnetd "$pkgdir"/etc/init.d/telnetd
}


