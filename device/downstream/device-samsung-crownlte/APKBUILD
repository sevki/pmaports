# Reference: <https://postmarketos.org/devicepkg>
maintainer="Thorben T. <r00t@constancy.org>"
pkgname=device-samsung-crownlte
pkgdesc="Samsung Galaxy Note 9"
pkgver=4
pkgrel=2
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	bluez-deprecated
	firmware-samsung-crownlte
	linux-samsung-crownlte
	mkbootimg-osm0sis
	msm-fb-refresher
	postmarketos-base
	postmarketos-base-downstream
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	initfs-hook.sh
	stylus.conf
	hciattach
	10-hciattach.rules
"
subpackages="
	$pkgname-openrc
	$pkgname-udev
	$pkgname-x11
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# hciattach service for Bluetooth
	install -Dm755 "$srcdir"/hciattach \
		-t "$pkgdir"/etc/init.d
	install -Dm644 "$srcdir"/10-hciattach.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d
}

x11() {
	install_if="$pkgname=$pkgver-r$pkgrel xorg-server"
	depends="xf86-input-evdev"
	install -Dm644 "$srcdir"/stylus.conf \
		-t "$subpkgdir"/usr/share/X11/xorg.conf.d
}

