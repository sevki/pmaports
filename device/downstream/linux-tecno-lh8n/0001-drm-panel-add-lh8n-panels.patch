diff -Naur a/drivers/gpu/drm/panel/panel-lh8n.c b/drivers/gpu/drm/panel/panel-lh8n.c
--- a/drivers/gpu/drm/panel/panel-lh8n.c	1970-01-01 03:00:00.000000000 +0300
+++ b/drivers/gpu/drm/panel/panel-lh8n.c	2026-09-20 18:11:41.500514258 +0300
@@ -0,0 +1,397 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * DSI video-mode panels of the Tecno LH8n (Pova 5 Pro):
+ *   FocalTech FT8726 (TM glass)   "ft8726,fhdp,dsi,vdo,tm,tm,lh8n"
+ *   ILITEK ILI7807S (TXD/BOE)     "ili7807s,fhdp,dsi,vdo,txd,boe,lh8n"
+ * Init tables, timings and power-up order come from the stock LK and the
+ * vendor panel modules. Items marked VERIFY are inferred, not confirmed.
+ */
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/of_graph.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_connector.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+#include "../mediatek/mediatek_v2/mtk_panel_ext.h"
+
+#include "panel-lh8n-ft8726-init.h"
+#include "panel-lh8n-ili7807s-init.h"
+
+/* VERIFY: approximate size of a 6.78" 1080x2460 panel */
+#define LH8N_W_MM	69
+#define LH8N_H_MM	158
+
+static bool sim;
+module_param(sim, bool, 0444);
+MODULE_PARM_DESC(sim, "simulator: skip the vdd regulator and the bias I2C chip");
+
+struct lh8n_variant {
+	const u8 *init;
+	size_t init_len;
+	struct drm_display_mode mode;
+	struct mtk_panel_params params;
+};
+
+struct lh8n {
+	struct device *dev;
+	struct drm_panel panel;
+	struct lh8n_variant *var;
+	struct regulator *vdd;
+	struct i2c_client *bias;
+	bool prepared;
+};
+
+#define panel_to_lh8n(p) container_of(p, struct lh8n, panel)
+
+/* VERIFY pll_clk/data_rate: 379 MHz pixel clock * 24 bit / 4 lanes = ~2.28 Gbit/s/lane */
+static struct lh8n_variant lh8n_ft8726 = {
+	.init = ft8726_init,
+	.init_len = sizeof(ft8726_init),
+	.mode = {
+		.clock = 379182,
+		.hdisplay = 1080, .hsync_start = 1080 + 122,
+		.hsync_end = 1080 + 122 + 10, .htotal = 1080 + 122 + 10 + 34,
+		.vdisplay = 2460, .vsync_start = 2460 + 52,
+		.vsync_end = 2460 + 52 + 4, .vtotal = 2460 + 52 + 4 + 20,
+	},
+	.params = { .pll_clk = 1138, .data_rate = 2276 },
+};
+
+static struct lh8n_variant lh8n_ili7807s = {
+	.init = ili7807s_init,
+	.init_len = sizeof(ili7807s_init),
+	.mode = {
+		.clock = 381015,
+		.hdisplay = 1080, .hsync_start = 1080 + 150,
+		.hsync_end = 1080 + 150 + 4, .htotal = 1080 + 150 + 4 + 20,
+		.vdisplay = 2460, .vsync_start = 2460 + 40,
+		.vsync_end = 2460 + 40 + 4, .vtotal = 2460 + 40 + 4 + 28,
+	},
+	.params = { .pll_clk = 1143, .data_rate = 2286 },
+};
+
+/* like the vendor modules: get, set, put (the lines are shared with other users) */
+static int lh8n_gpio(struct device *dev, const char *con, int idx, int val)
+{
+	struct gpio_desc *d;
+
+	d = devm_gpiod_get_index(dev, con, idx, val ? GPIOD_OUT_HIGH : GPIOD_OUT_LOW);
+	if (IS_ERR(d)) {
+		dev_err(dev, "cannot get %s-gpios[%d]: %ld\n", con, idx, PTR_ERR(d));
+		return PTR_ERR(d);
+	}
+	gpiod_set_value(d, val);
+	devm_gpiod_put(dev, d);
+	return 0;
+}
+
+/* GPIO 19 is toggled together with the panel reset by LK; not in the stock panel node */
+static void lh8n_tp_reset(struct device *dev, int val)
+{
+	struct gpio_desc *d;
+
+	d = devm_gpiod_get_optional(dev, "tp-reset", val ? GPIOD_OUT_HIGH : GPIOD_OUT_LOW);
+	if (IS_ERR_OR_NULL(d))
+		return;
+	gpiod_set_value(d, val);
+	devm_gpiod_put(dev, d);
+}
+
+/* table format: len, cmd, params... ; len 0 = delay of the next byte in ms */
+static int lh8n_send_table(struct lh8n *ctx, const u8 *p, size_t n)
+{
+	struct mipi_dsi_device *dsi = to_mipi_dsi_device(ctx->dev);
+	const u8 *end = p + n;
+	ssize_t ret;
+
+	while (p < end) {
+		u8 len = *p++;
+
+		if (!len) {
+			msleep(*p++);
+			continue;
+		}
+		ret = mipi_dsi_dcs_write_buffer(dsi, p, len);	/* VERIFY: LK sends everything as DCS */
+		if (ret < 0) {
+			dev_err(ctx->dev, "DCS write 0x%02x failed: %zd\n", p[0], ret);
+			return ret;
+		}
+		if (len > 21)			/* LK: 1 ms after commands with > 20 params */
+			usleep_range(1000, 1500);
+		else if (len > 2)		/* LK: 100 us after commands with > 1 param */
+			usleep_range(100, 200);
+		p += len;
+	}
+	return 0;
+}
+
+static int lh8n_bias_on(struct lh8n *ctx)
+{
+	static const struct { u8 reg, val, ms; } seq[] = {
+		{ 0x00, 0x0f, 1 }, { 0x01, 0x0f, 1 }, { 0x03, 0x33, 1 }, { 0xff, 0x80, 10 },
+	};
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(seq); i++) {
+		ret = i2c_smbus_write_byte_data(ctx->bias, seq[i].reg, seq[i].val);
+		if (ret < 0) {
+			dev_err(ctx->dev, "bias reg 0x%02x write failed: %d\n", seq[i].reg, ret);
+			return ret;
+		}
+		if (seq[i].ms == 1)
+			usleep_range(1000, 1500);
+		else
+			msleep(seq[i].ms);
+	}
+	return 0;
+}
+
+static void lh8n_power_off(struct lh8n *ctx)
+{
+	lh8n_gpio(ctx->dev, "reset", 0, 0);
+	lh8n_gpio(ctx->dev, "bias", 1, 0);
+	usleep_range(1000, 2000);
+	lh8n_gpio(ctx->dev, "bias", 0, 0);
+}
+
+static int lh8n_prepare(struct drm_panel *panel)
+{
+	struct lh8n *ctx = panel_to_lh8n(panel);
+	int ret;
+
+	if (ctx->prepared)
+		return 0;
+
+	if (ctx->vdd) {
+		ret = regulator_enable(ctx->vdd);
+		if (ret)
+			return ret;
+		msleep(10);
+	}
+	ret = lh8n_gpio(ctx->dev, "bias", 0, 1);
+	if (ret)
+		return ret;
+	msleep(10);
+	ret = lh8n_gpio(ctx->dev, "bias", 1, 1);
+	if (ret)
+		goto err;
+	msleep(10);
+	if (ctx->bias) {
+		ret = lh8n_bias_on(ctx);
+		if (ret)
+			goto err;
+	}
+
+	/* reset waveform, as in LK */
+	lh8n_gpio(ctx->dev, "reset", 0, 0);	msleep(5);
+	lh8n_tp_reset(ctx->dev, 0);		msleep(5);
+	lh8n_gpio(ctx->dev, "reset", 0, 1);	msleep(10);
+	lh8n_gpio(ctx->dev, "reset", 0, 0);	msleep(10);
+	lh8n_gpio(ctx->dev, "reset", 0, 1);	msleep(10);
+	lh8n_tp_reset(ctx->dev, 1);		msleep(10);
+	lh8n_tp_reset(ctx->dev, 0);		msleep(10);
+	lh8n_tp_reset(ctx->dev, 1);		msleep(25);
+
+	ret = lh8n_send_table(ctx, ctx->var->init, ctx->var->init_len);
+	if (ret)
+		goto err;
+
+	ctx->prepared = true;
+	dev_info(ctx->dev, "panel initialised (%zu byte init stream)\n", ctx->var->init_len);
+	return 0;
+err:
+	lh8n_power_off(ctx);
+	return ret;
+}
+
+static int lh8n_unprepare(struct drm_panel *panel)
+{
+	static const u8 suspend[] = { 1, 0x28, 0, 20, 1, 0x10, 0, 120 };
+	struct lh8n *ctx = panel_to_lh8n(panel);
+
+	if (!ctx->prepared)
+		return 0;
+	lh8n_send_table(ctx, suspend, sizeof(suspend));
+	lh8n_power_off(ctx);	/* vdd stays on: the vendor cuts it separately (lcm_disable_vdd) */
+	ctx->prepared = false;
+	return 0;
+}
+
+static int lh8n_enable(struct drm_panel *panel)  { return 0; }
+static int lh8n_disable(struct drm_panel *panel) { return 0; }
+
+static int lh8n_get_modes(struct drm_panel *panel, struct drm_connector *connector)
+{
+	struct lh8n *ctx = panel_to_lh8n(panel);
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &ctx->var->mode);
+	if (!mode)
+		return -ENOMEM;
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+	connector->display_info.width_mm = LH8N_W_MM;
+	connector->display_info.height_mm = LH8N_H_MM;
+	return 1;
+}
+
+static const struct drm_panel_funcs lh8n_panel_funcs = {
+	.prepare = lh8n_prepare,
+	.unprepare = lh8n_unprepare,
+	.enable = lh8n_enable,
+	.disable = lh8n_disable,
+	.get_modes = lh8n_get_modes,
+};
+
+/* mtk_panel_ext hooks; signatures from the header diff against OPPO's tree */
+static int lh8n_ext_reset(struct drm_panel *panel, int on)
+{
+	return lh8n_gpio(panel_to_lh8n(panel)->dev, "reset", 0, !!on);
+}
+
+static int lh8n_ext_param_set(struct drm_panel *panel, struct drm_connector *connector,
+			      unsigned int mode)
+{
+	struct mtk_panel_ext *ext = find_panel_ext(panel);
+
+	ext->params = &panel_to_lh8n(panel)->var->params;
+	return 0;
+}
+
+static int lh8n_ext_param_get(struct drm_panel *panel, struct drm_connector *connector,
+			      struct mtk_panel_params **ext_para, unsigned int mode)
+{
+	*ext_para = &panel_to_lh8n(panel)->var->params;
+	return 0;
+}
+
+static struct mtk_panel_funcs lh8n_ext_funcs = {
+	.reset = lh8n_ext_reset,
+	.ext_param_set = lh8n_ext_param_set,
+	.ext_param_get = lh8n_ext_param_get,
+};
+
+/* same rule as the vendor modules: only the panel the DSI graph points at probes */
+static bool lh8n_is_current(struct device *dev)
+{
+	struct device_node *dsi_node, *ep, *remote;
+	bool cur;
+
+	dsi_node = of_get_parent(dev->of_node);
+	if (!dsi_node)
+		return false;
+	ep = of_graph_get_next_endpoint(dsi_node, NULL);
+	of_node_put(dsi_node);
+	if (!ep)
+		return false;
+	remote = of_graph_get_remote_port_parent(ep);
+	of_node_put(ep);
+	cur = remote == dev->of_node;
+	of_node_put(remote);
+	return cur;
+}
+
+static void lh8n_put_bias(void *data)
+{
+	put_device(&((struct i2c_client *)data)->dev);
+}
+
+static int lh8n_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct device_node *np;
+	struct lh8n *ctx;
+	int ret;
+
+	if (!lh8n_is_current(dev))
+		return -ENODEV;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+	ctx->dev = dev;
+	ctx->var = (struct lh8n_variant *)of_device_get_match_data(dev);
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/* VERIFY against the vendor lcm_probe */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_EOT_PACKET |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	if (!sim) {
+		ctx->vdd = devm_regulator_get(dev, "vdd");
+		if (IS_ERR(ctx->vdd))
+			return dev_err_probe(dev, PTR_ERR(ctx->vdd), "vdd supply\n");
+		ret = regulator_set_voltage(ctx->vdd, 1800000, 1800000);
+		if (ret)
+			return dev_err_probe(dev, ret, "vdd 1.8 V\n");
+
+		np = of_find_compatible_node(NULL, NULL, "mediatek,I2C_LCD_BIAS");
+		if (!np)
+			return -ENODEV;
+		ctx->bias = of_find_i2c_device_by_node(np);
+		of_node_put(np);
+		if (!ctx->bias)
+			return -EPROBE_DEFER;
+		ret = devm_add_action_or_reset(dev, lh8n_put_bias, ctx->bias);
+		if (ret)
+			return ret;
+	}
+
+	drm_panel_init(&ctx->panel, dev, &lh8n_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	ret = mtk_panel_ext_create(dev, &ctx->var->params, &lh8n_ext_funcs, &ctx->panel);
+	if (ret < 0)
+		return ret;
+
+	dev_info(dev, "LH8n panel bound (%s)\n", of_node_full_name(dev->of_node));
+	return 0;
+}
+
+static int lh8n_remove(struct mipi_dsi_device *dsi)
+{
+	struct lh8n *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+	return 0;
+}
+
+static const struct of_device_id lh8n_of_match[] = {
+	{ .compatible = "ft8726,fhdp,dsi,vdo,tm,tm,lh8n", .data = &lh8n_ft8726 },
+	{ .compatible = "ili7807s,fhdp,dsi,vdo,txd,boe,lh8n", .data = &lh8n_ili7807s },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, lh8n_of_match);
+
+static struct mipi_dsi_driver lh8n_driver = {
+	.probe = lh8n_probe,
+	.remove = lh8n_remove,
+	.driver = {
+		.name = "panel-lh8n",
+		.owner = THIS_MODULE,
+		.of_match_table = lh8n_of_match,
+	},
+};
+module_mipi_dsi_driver(lh8n_driver);
+
+MODULE_DESCRIPTION("Tecno LH8n DSI panels (FocalTech FT8726, ILITEK ILI7807S)");
+MODULE_LICENSE("GPL");
