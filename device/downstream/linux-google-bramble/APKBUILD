# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: LineageOS 23.2 running config (dumped from device)
maintainer="Yurii Bishchuk <yuriikovaldev@gmail.com>"
pkgname=linux-google-bramble
pkgver=4.19.325
pkgrel=0
_commit="2af5306961aebce4cc30098c9f12a09f8d906906"
pkgdesc="Google Pixel 4a (5G) downstream kernel (LineageOS 23.2)"
arch="aarch64"
_carch="arm64"
url="https://github.com/LineageOS/android_kernel_google_redbull"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
"
makedepends="
	android-tools-mkdtboimg
	bash
	bc
	bison
	clang
	devicepkg-dev
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	lz4
	openssl-dev
	perl
	python3
"
source="
	$pkgname-$_commit.tar.gz::$url/archive/$_commit.tar.gz
	config-${pkgname#linux-}.$arch
"
builddir="$srcdir/android_kernel_google_redbull-$_commit"
_outdir="out"
_config="config-${pkgname#linux-}.$arch"
_flavor="${pkgname#linux-}"

prepare() {
	default_prepare
	export LLVM=1
	export REPLACE_GCCH=0
	sed -i '/dtbo-redfin/d; /dtbo-barbet/d' "$builddir"/scripts/Makefile.dtbo
	sed -i '/dtbo_redfin/d; /dtbo_barbet/d' "$builddir"/arch/arm64/Makefile
	. downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	make -j4 O="$_outdir" ARCH="$_carch" LLVM=1 KBUILD_LDFLAGS="--threads=4" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))"-postmarketOS
}

package() {
	export KERNEL_IMAGE_NAME="Image.lz4"
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"${pkgname#linux-}" "$_outdir"
	make -j4 O="$_outdir" ARCH="$_carch" LLVM=1 \
		INSTALL_MOD_PATH="$pkgdir"/usr INSTALL_MOD_STRIP=1 modules_install
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source
	install -Dm644 "$builddir/$_outdir"/arch/$_carch/boot/dts/google/qcom-base/lito-v2.dtb \
		"$pkgdir"/boot/dtbs/lito-v2.dtb
}
