+static ssize_t writemode_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct goodix_berlin_core *cd = dev_get_drvdata(dev);
+	return sprintf(buf, "%d\n", cd->writemode);
+}
+
+static ssize_t writemode_store(struct device *dev, struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct goodix_berlin_core *cd = dev_get_drvdata(dev);
+	unsigned int val;
+	int ret;
+
+	if (kstrtouint(buf, 10, &val))
+		return -EINVAL;
+
+	cd->writemode = (u8)val;
+	if (val == 1)
+		ret = goodix_berlin_send_cmd(cd, GOODIX_BERLIN_CMD_MODE_SET, GOODIX_BERLIN_MODE_NORMAL);
+	else
+		ret = goodix_berlin_send_cmd(cd, GOODIX_BERLIN_CMD_MODE_SET, GOODIX_BERLIN_MODE_NORMAL);
+
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(writemode);
