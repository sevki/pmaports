+static int goodix_berlin_send_cmd(struct goodix_berlin_core *cd, u8 cmd, u8 subcmd)
+{
+	u8 buf[16] = {0};
+	u16 checksum = 0;
+	int i, len;
+	int error;
+
+	if (!cd->cmd_addr) {
+		dev_warn(cd->dev, "cmd_addr is null, cannot send cmd\n");
+		return -EINVAL;
+	}
+
+	buf[0] = 0x01; /* CMD ready / send */
+	buf[1] = 0x00; /* ACK */
+	buf[2] = 0x02; /* payload length */
+	buf[3] = cmd;  /* 0x04 mode set */
+	buf[4] = subcmd; /* 0x14 pen on */
+
+	len = 5;
+	for (i = 0; i < len; i++)
+		checksum += buf[i];
+
+	put_unaligned_le16(checksum, &buf[len]);
+
+	error = regmap_raw_write(cd->regmap, cd->cmd_addr, buf, len + sizeof(u16));
+	if (error) {
+		dev_err(cd->dev, "failed to send cmd 0x%02x 0x%02x: %d\n", cmd, subcmd, error);
+		return error;
+	}
+
+	dev_info(cd->dev, "Goodix Berlin: sent command 0x%02x 0x%02x to 0x%08x\n",
+		 cmd, subcmd, cd->cmd_addr);
+	return 0;
+}
