# Reference: <https://postmarketos.org/vendorkernel>
maintainer="Andrea Del Sarto <delsadj@gmail.com>"
_flavor="lenovo-q706f"
pkgname=linux-$_flavor
pkgver=7.2.0
pkgrel=0
pkgdesc="Mainline Linux 7.2 kernel for Lenovo Tab P12 Pro (Q706F)"
arch="aarch64"
_carch="arm64"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-uefi
"
makedepends="
	bash
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"

_tag="sm8250-$pkgver"
_config="config-$_flavor.$arch"
source="
	linux-lenovo-q706f-$_tag.tar.gz::https://gitlab.postmarketos.org/soc/qualcomm-sm8250/linux/-/archive/$_tag/linux-$_tag.tar.gz
	$_config
	0002-arm64-dts-sm8250-lenovo-q706f-use-qup_spi13_cs_gpio.patch
	0003-goodix-berlin-stylus-support.patch
	0004-sound-sm8250-support-primary-tdm-capture.patch
	0005-sound-enable-microphone-capture-tdm.patch
"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config
	make ARCH="$_carch" LLVM=1 olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot

	if [ -f "$builddir/arch/$_carch/boot/vmlinuz" ]; then
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz" "$pkgdir/boot/vmlinuz"
	elif [ -f "$builddir/arch/$_carch/boot/Image.gz" ]; then
		install -Dm644 "$builddir/arch/$_carch/boot/Image.gz" "$pkgdir/boot/vmlinuz"
	elif [ -f "$builddir/arch/$_carch/boot/vmlinuz.efi" ]; then
		install -Dm644 "$builddir/arch/$_carch/boot/vmlinuz.efi" "$pkgdir/boot/vmlinuz"
	fi

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

