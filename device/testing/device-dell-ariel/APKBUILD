# Reference: <https://nura.eco/devicepkg>
maintainer="Robert Eckelmann <longnoserob@postmarketos.org>"
pkgname=device-dell-ariel
pkgdesc="Device package for the Dell Wyse 3020 thin-client"
pkgver=2
pkgrel=0
url="https://nura.eco"
license="MIT"
arch="armv7"
options="!check !archcheck"
# todo: # switch back to nura-mainline kernel once that is merged and dell-ariel.dts has been upstreamed
depends="
	linux-nura-marvell
	postmarketos-base
	u-boot-tools
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
	wloader.cfg
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir"/wloader.cfg "$pkgdir"/boot/wloader.cfg
}

