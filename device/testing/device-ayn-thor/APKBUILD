# Reference: <https://postmarketos.org/devicepkg>
maintainer="Seshan Ravikumar <seshan@sineware.ca>"
pkgname=device-ayn-thor
pkgdesc="AYN Thor"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alsa-ucm-conf-ayn
	firmware-ayn-audioreach-topology
	firmware-ayn-thor
	linux-ayn-thor
	linux-firmware-ath12k
	linux-firmware-qca
	linux-firmware-qcom
	postmarketos-base
	soc-qcom
	soc-qcom-qbootctl
	systemd-boot
	unl0kr-fbforcerefresh
"
makedepends="devicepkg-dev"
source="
	61-ayn-thor-gamepad.rules
	90-ayn-thor-touchscreen.rules
	deviceinfo
	kcminputrc
	kernel-cmdline.conf
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/61-ayn-thor-gamepad.rules \
		"$srcdir"/90-ayn-thor-touchscreen.rules \
		-t "$pkgdir"/usr/lib/udev/rules.d
	install -Dm644 "$srcdir"/kcminputrc \
		-t "$pkgdir"/etc/xdg
}

