# Reference: <https://postmarketos.org/devicepkg>
maintainer="Henrik Grimler <henrik@grimler.se>"
pkgname=device-google-daisy
pkgdesc="Samsung Chromebook"
pkgver=13
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	alsa-ucm-conf
	depthcharge-tools
	linux-firmware-mrvl
	linux-firmware-s5p-mfc
	linux-postmarketos-exynos5
	postmarketos-base
	postmarketos-cros-common
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	ucm/HiFi.conf
	ucm/Snow-I2S-MAX98090.conf
"
# provides and replaces to upgrade old installations
provides="
	device-google-snow=$pkgver-r$pkgrel
	device-google-spring=$pkgver-r$pkgrel
"
replaces="
	device-google-snow
	device-google-spring
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Alsa UCM configs
	install -Dm644 "$srcdir"/Snow-I2S-MAX98090.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/Snow-I2S-MAX980/Snow-I2S-MAX98090.conf
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/Snow-I2S-MAX980/HiFi.conf
}


