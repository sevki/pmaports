# the *_url variables below are separate for readability, to avoid
# making the source lines too long

# not upstream yet, the dispcc fix is needed to take over the display,
# since the bootloader leaves them running when booting via EFI
_rocknix_commit="fe127fad01f6006bea1734ebde87d1c02cc6d256"
_rocknix_url="https://raw.githubusercontent.com/ROCKNIX/distribution/$_rocknix_commit/projects/ROCKNIX/devices/SM8550/patches/linux"

# fixes for gamepad input drops, speaker amp mi2s clock
_armada_commit="410bcf26a67f3e5d38e487d0ec84c5632f2bc3f6"
_armada_url="https://raw.githubusercontent.com/armada-os/armada/$_armada_commit/packages/kernel/patches"

# qcs8550-ayntec-common/thor DTs are pretty big as patches (and not checksum stable from cgit as a patch),
# and queued for 7.4 anyway, so just download them for now as a backport. Then this will be dropped entirely soon
_qcom_commit="ac99695769bab4d9e21b0458e0f7b0c2165fe2de"
_qcom_dts_url="https://git.kernel.org/pub/scm/linux/kernel/git/qcom/linux.git/plain/arch/arm64/boot/dts/qcom"
source="
	$pkgname-$pkgver.tar.gz::https://git.kernel.org/torvalds/t/linux-${pkgver/_/-}.tar.gz
	config-${pkgname#linux-}.$arch
	PCI-qcom-Honor-IOMMU-provider-s-iommu-cells.patch
	qcs8550-ayntec-common.dtsi::$_qcom_dts_url/qcs8550-ayntec-common.dtsi?id=$_qcom_commit
	qcs8550-ayntec-thor.dts::$_qcom_dts_url/qcs8550-ayntec-thor.dts?id=$_qcom_commit
	$_rocknix_url/0002-qcom-dispcc-sm8550-Fix-disp_cc_mdss_mdp_clk_src.patch
	$_rocknix_url/0015-touchscreen-edt-ft5x06-allow-to-override-input-name.patch
	$pkgname-0031_input--Add-driver-for-RSInput-Gamepad.patch::$_rocknix_url/0031_input--Add-driver-for-RSInput-Gamepad.patch
	$_armada_url/0515-input-rsinput-reassemble-uart-frames-instead-of-dropping-them.patch
	$_rocknix_url/0612-ROCKNIX-odin3-q6apm-start-mi2s-port-at-prepare.patch
	$_armada_url/0613-ASoC-q6apm-scope-prepare-start-to-MI2S.patch
	0001-arm64-dts-qcom-qcs8550-ayntec-thor-add-RSInput-gamepad.patch
	0002-arm64-dts-qcom-qcs8550-ayntec-thor-label-touchscreens.patch
"
builddir="$srcdir/linux-${pkgver/_/-}"

# Used internally by pmbootstrap. Don't touch.
# TODO: Remove once minimum default pmbootstrap version supports
# kernel packages without '_flavor' and '_config'.
_flavor="${pkgname#linux-}"
_config="config-${pkgname#linux-}.$arch"

prepare() {
	cp "$srcdir"/qcs8550-ayntec-common.dtsi "$srcdir"/qcs8550-ayntec-thor.dts \
		arch/$_carch/boot/dts/qcom/
	echo 'dtb-$(CONFIG_ARCH_QCOM) += qcs8550-ayntec-thor.dtb' \
		>> arch/$_carch/boot/dts/qcom/Makefile

	default_prepare

	cp "$srcdir"/config-${pkgname#linux-}.$arch .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -Dm644 "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/${pkgname#linux-}/kernel.release
}

