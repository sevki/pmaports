maintainer="Anton Bambura <jenneron@protonmail.com>"
pkgname=alsa-ucm-conf-ayn
pkgver=1.2.15.3_git20260415
_commit="52b6ae98b7cd01e35ab6d193f953394dcefe5c0e"
pkgrel=1
pkgdesc="ALSA UCM configuration for AYN Odin 2, Odin 3 and Thor devices"
url="https://github.com/AYNTechnologies/alsa-ucm-conf"
arch="aarch64"
license="BSD-3-Clause"
provides="alsa-ucm-conf=0.${pkgver%_*}" # versioned provides need to be below default version
provider_priority=1
_rocknix_commit="fe127fad01f6006bea1734ebde87d1c02cc6d256"
source="
	$pkgname-$_commit.tar.gz::https://github.com/AYNTechnologies/alsa-ucm-conf/archive/$_commit.tar.gz
	https://raw.githubusercontent.com/ROCKNIX/distribution/$_rocknix_commit/projects/ROCKNIX/packages/audio/alsa-ucm-conf/patches/SM8550/0005_Add-AYN-Thor.patch
"
options="!check"
builddir="$srcdir/alsa-ucm-conf-$_commit"

package() {
	mkdir -p "$pkgdir"/usr/share/alsa
	cp -r "$builddir"/ucm2 \
		"$pkgdir"/usr/share/alsa/
	# the upstream sm8550 AYN DTs name the sound card AYN-Odin2
	ln -s ../../AYN/Thor/AYN-Thor.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/sm8550/AYN-Odin2.conf
}

