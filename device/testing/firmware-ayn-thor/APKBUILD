package() {
	local _f

	for _f in cdsp.mbn cdsp_dtb.mbn; do
		install -Dm644 "$srcdir"/"$pkgname"-"$_commit"-"$_f" \
			"$pkgdir"/usr/lib/firmware/qcom/sm8550/ayntec/"$_f"
	done

	for _f in adsp.mbn adsp_dtb.mbn adspr.jsn adsps.jsn adspua.jsn \
			aw883xx_acf.bin battmgr.jsn; do
		install -Dm644 "$srcdir"/"$pkgname"-"$_commit"-"$_f" \
			"$pkgdir"/usr/lib/firmware/qcom/sm8550/ayntec/thor/"$_f"
	done

	install -Dm644 "$srcdir"/"$pkgname"-"$_commit"-board-2.bin \
		"$pkgdir"/usr/lib/firmware/postmarketos/ath12k/WCN7850/hw2.0/board-2.bin
}

