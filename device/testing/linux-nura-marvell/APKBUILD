# Reference: https://github.com/archlinuxarm/PKGBUILDs/blob/d2ee78cab3c298583eb3f3bed4d75970f54885be/core/linux-armv7/config
# Kernel config based on: ~2021 mainline kernel of the linux-armv7 package (5.x mainline) from archlinux arm
# Co-Maintainer: exkc <exkc@exkc.moe>
maintainer="Robert Eckelmann <longnoserob@postmarketos.org>"
pkgname=linux-nura-marvell
pkgver=6.18.56
pkgrel=0
pkgdesc="mainline (stable) for Marvell SoC"
arch="armv7"
_carch="arm"
_flavor="${pkgname#linux-}"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native pmb:kconfigcheck-community"
makedepends="
	bc
	bison
	clang
	devicepkg-dev
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	python3
	xz
	zstd
"
provides="linux-postmarketos-marvell"
replaces="linux-postmarketos-marvell-dove"

# Source
_config="config-$_flavor.$arch"
source="
	0001-dts-marvell-mmp3-merge-parts-from-linux-mmp.patch
	0002-dts-marvell-mmp3-dell-ariel-merge-parts-from-linux-m.patch
	0003-dts-marvell-mmp-dell-ariel-add-framebuffer.patch
	0004-arm-boot-dts-marvell-mmp3.dtsi-fix-dma-interrupts.patch
	wd-glacier.patch
	$pkgname-$pkgver.tar.xz::https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/linux-$pkgver.tar.xz
	$_config
"
builddir="$srcdir/linux-$pkgver"

prepare() {
	default_prepare
	cp -v "$srcdir"/$_config .config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	install -Dm644 "$builddir/arch/$_carch/boot/zImage" \
		"$pkgdir/boot/vmlinuz"

	make modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot/ \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}


