maintainer="Jan-Michael Brummer <jan.brummer@tabos.org>"
pkgname=agps-inject
pkgver=1.0.0
pkgrel=0
pkgdesc="Periodically download and inject GNSS assistance data (XTRA) via ModemManager"
url="https://postmarketos.org"
arch="noarch"
license="GPL-3.0-or-later"
depends="modemmanager"
subpackages="$pkgname-systemd"
source="
	agps-inject
	agps-inject.service
	agps-inject.timer
	90-agps-inject.preset
	"
options="!check" # no testsuite

package() {
	install -Dm755 "$srcdir"/agps-inject \
		"$pkgdir"/usr/libexec/agps-inject
	install -Dm644 "$srcdir"/agps-inject.service \
		"$pkgdir"/usr/lib/systemd/system/agps-inject.service
	install -Dm644 "$srcdir"/agps-inject.timer \
		"$pkgdir"/usr/lib/systemd/system/agps-inject.timer
	install -Dm644 "$srcdir"/90-agps-inject.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-agps-inject.preset
}

